# KeeperHub organization API key (server-side only, never sent to the browser).
KEEPERHUB_API_KEY=

# Default chain for new strategies: 421614 (Arbitrum Sepolia) or 42161 (Arbitrum One).
STRATEGY_CHAIN_ID=42161

# Server port.
PORT=8787

# Optional LLM planner. A Gemini API key enables the LLM planner; without it the
# server uses the deterministic regex planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI-compatible alternative (optional).
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
