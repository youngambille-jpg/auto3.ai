# KeeperHub organization API key (server-side only, never sent to the browser).
KEEPERHUB_API_KEY=

# Default chain for new strategies: 421614 (Arbitrum Sepolia) or 42161 (Arbitrum One).
STRATEGY_CHAIN_ID=42161

# Server port.
PORT=8787

# LLM planner. An LLM is REQUIRED — there is no deterministic/regex fallback.
# Providers are tried in order (see LLM_PROVIDER_ORDER); a flaky provider fails
# over to the next one. Configure at least one of GEMINI_API_KEY / OPENROUTER_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenRouter (recommended fallback; also the primary if you set the order).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider order for the fallback chain. Default: gemini,openrouter,openai
# LLM_PROVIDER_ORDER=gemini,openrouter

# Per-request timeout; a slow provider should not block the chain.
# LLM_TIMEOUT_MS=20000

# Any OpenAI-compatible endpoint (optional).
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
