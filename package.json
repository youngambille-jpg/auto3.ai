{
  "name": "strategy-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Describe an onchain trading strategy in plain English, preview it as a card, approve, and execute it on Arbitrum via KeeperHub.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx --env-file=.env src/server/index.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "node --import tsx --env-file=.env --test test/live.keeperhub.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
